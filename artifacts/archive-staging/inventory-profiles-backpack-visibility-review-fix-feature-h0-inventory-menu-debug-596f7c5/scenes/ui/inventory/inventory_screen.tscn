[node name="ProjectionToolbar" type="HBoxContainer" parent="Margin/Main"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="SearchEdit" type="LineEdit" parent="Margin/Main/ProjectionToolbar"]
