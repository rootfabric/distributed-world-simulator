{
  "schema": "distributed_world_simulator.agent_execution_profiles.v1",
  "revision": "H0-AGENT-EXEC-2026-09-06-R1",
  "default_profile": "ADAPTIVE",
  "principles": {
    "checkpoint_mission_truth_is_unchanged": true,
    "execution_slice_is_not_checkpoint_acceptance": true,
    "git_is_the_restart_boundary": true,
    "external_wait_must_not_hold_a_reasoning_session_open": true,
    "profile_changes_may_affect_slice_length_but_not_project_truth": true
  },
  "global_rules": {
    "external_pending_safe_states": [
      "IMPLEMENTED",
      "VERIFYING",
      "VERIFIED",
      "AUDITED",
      "CHECKPOINT_PROPOSED",
      "FIX_REQUIRED",
      "BLOCKED",
      "WAITING_HUMAN",
      "EPOCH_INVALIDATED",
      "CANCELLED"
    ],
    "do_not_recommend_yield_actions": [
      "EVALUATE_CHECKPOINT_ACCEPTANCE_OR_REQUIRED_HUMAN_GATE",
      "REPORT_CHECKPOINT_MISSION_COMPLETE"
    ]
  },
  "profiles": {
    "ADAPTIVE": {
      "yield_on_durable_role_boundary": false,
      "yield_on_fresh_context_boundary": true,
      "yield_on_external_pending": true,
      "fresh_context_actors": [
        "REVIEWER",
        "VERIFIER"
      ],
      "same_role_yield_states": [
        "VERIFYING"
      ],
      "yield_on_states": [
        "VERIFYING"
      ]
    },
    "BOUNDED_DEEP_REASONING": {
      "yield_on_durable_role_boundary": true,
      "yield_on_fresh_context_boundary": true,
      "yield_on_external_pending": true,
      "fresh_context_actors": [
        "REVIEWER",
        "VERIFIER",
        "DIRECTOR"
      ],
      "same_role_yield_states": [
        "VERIFYING",
        "FIX_REQUIRED"
      ],
      "yield_on_states": [
        "VERIFYING",
        "FIX_REQUIRED"
      ]
    },
    "LONG_HORIZON_CONTINUOUS": {
      "yield_on_durable_role_boundary": false,
      "yield_on_fresh_context_boundary": false,
      "yield_on_external_pending": true,
      "fresh_context_actors": [],
      "same_role_yield_states": [],
      "yield_on_states": []
    }
  }
}
