{
  "schema": "distributed_world_simulator.execution_resources.v1",
  "revision": "H0-EXECUTION-RESOURCES-2026-09-06-R1",
  "canonical_owner": "main",
  "principles": {
    "execution_resource_is_not_role": true,
    "runner_identity_is_operational_not_canonical": true,
    "self_hosted_runner_is_validation_and_evidence_only": true,
    "github_actions_is_not_git_transport": true,
    "external_fork_execution_on_self_hosted_is_forbidden": true,
    "local_implementer_validation_remains_available": true,
    "exact_head_supersedes_queued_predecessor": true
  },
  "routing": {
    "default_verifier_resource": "DWS_LINUX_EXACT",
    "role_resource_preferences": {
      "IMPLEMENTER": [
        "LOCAL"
      ],
      "REVIEWER": [
        "LOCAL"
      ],
      "VERIFIER": [
        "DWS_LINUX_EXACT",
        "LOCAL"
      ],
      "INTEGRATOR": [
        "DWS_LINUX_EXACT",
        "LOCAL"
      ],
      "PC0": [
        "LOCAL"
      ],
      "DIRECTOR": [
        "LOCAL"
      ],
      "HUMAN": [
        "LOCAL"
      ]
    },
    "heavyweight_resource_capacity_is_authoritative": true
  },
  "resources": {
    "LOCAL": {
      "provider": "LOCAL_PROCESS",
      "capacity": 1,
      "capabilities": [
        "FOCUSED_VALIDATION",
        "IMPLEMENTER_SELF_VALIDATION",
        "CONTROL_LOGIC"
      ],
      "independent_verifier_environment": false
    },
    "DWS_LINUX_EXACT": {
      "provider": "GITHUB_ACTIONS_SELF_HOSTED",
      "repository": "rootfabric/distributed-world-simulator",
      "runner_selector": [
        "self-hosted",
        "Linux",
        "X64"
      ],
      "preferred_runner_selector_after_live_label_confirmation": [
        "self-hosted",
        "Linux",
        "X64",
        "dws-linux",
        "dws-godot-double"
      ],
      "selector_upgrade_condition": "LIVE_RUNNER_CUSTOM_LABELS_CONFIRMED",
      "capacity": 1,
      "capabilities": [
        "LINUX_X64",
        "GODOT_4_7_1_DOUBLE",
        "HEADLESS_GODOT",
        "COLD_IMPORT",
        "DETERMINISTIC_REPLAY",
        "EXACT_HEAD_VALIDATION",
        "ARTIFACT_EVIDENCE"
      ],
      "independent_verifier_environment": true,
      "operational_state_source": "GITHUB_LIVE_RUNNER_STATE_NOT_CANONICAL_GIT",
      "trust": {
        "trusted_actors": [
          "rootfabric"
        ],
        "trusted_head_repositories": [
          "rootfabric/distributed-world-simulator"
        ],
        "allowed_events": [
          "push",
          "workflow_dispatch"
        ],
        "pull_request_execution": false,
        "external_fork_execution": false
      },
      "github_permissions": {
        "contents": "read"
      },
      "dispatch_policy": {
        "use_existing_approved_workflow_or_separate_validation_scope": true,
        "workflow_mutation_in_product_implementation_scope": false,
        "source_commit_or_ref_publication": false,
        "git_transport_fallback": false
      }
    }
  },
  "queue_policy": {
    "max_dispatched_heavyweight_jobs_per_resource": 1,
    "exact_head_job_identity": "WORKFLOW+RESOURCE+SUBJECT_HEAD",
    "on_subject_head_change": "SUPERSEDE_AND_CANCEL_OLDER_QUEUED_EXACT_JOB",
    "queued_job_is_not_pass": true,
    "in_progress_job_is_not_pass": true,
    "completed_success_must_match_exact_subject_head": true
  },
  "fallback_policy": {
    "runner_unavailable_does_not_block_implementation": true,
    "runner_unavailable_may_block_required_independent_exact_verification": true,
    "do_not_create_or_mutate_workflow_to_bypass_resource_unavailability": true
  }
}
