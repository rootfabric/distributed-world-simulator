{
  "schema": "distributed_world_simulator.development_harness_policy.v1",
  "harness_revision": "H0-2026-08-11-R1",
  "policy_amendment_revision": "H0-PTRAIN-2026-08-18-R1",
  "review_layer_revision": "H0-REVIEW-2026-08-11-R1",
  "continuation_layer_revision": "H0-CONTINUATION-2026-08-20-R5",
  "canonical_branch": "main",
  "pc0_policy": "config/control/project-control-policy.v1.json",
  "project_goals": "config/control/harness/project-goals.v1.json",
  "checkpoint_catalog": "config/control/harness/checkpoint-catalog.v1.json",
  "scheduler_policy": "config/control/harness/scheduler-policy.v1.json",
  "v0_product_train_policy": "config/control/harness/v0-product-train-policy.v1.json",
  "work_order_schema": "config/control/harness/work-order.schema.v1.json",
  "event_schema": "config/control/harness/event.schema.v1.json",
  "project_epoch_schema": "config/control/harness/project-epoch.schema.v1.json",
  "risk_policy": "config/control/harness/risk-policy.v1.json",
  "review_policy": "config/control/harness/review-policy.v1.json",
  "repair_doctrine": "config/control/harness/repair-doctrine.v1.json",
  "evidence_map_schema": "config/control/harness/evidence-map.schema.v1.json",
  "human_attention_schema": "config/control/harness/human-attention.schema.v1.json",
  "continuation_policy": "config/control/harness/continuation-policy.v1.json",
  "principles": {
    "git_is_durable_memory": true,
    "chat_history_is_not_required_for_resume": true,
    "main_owns_goals_policy_and_project_state": true,
    "branches_report_execution_facts": true,
    "events_are_append_only": true,
    "derived_status_is_rebuildable": true,
    "implementer_cannot_self_accept_checkpoint": true,
    "one_atomic_predicate_per_commit_when_practical": true,
    "push_after_each_durable_atomic_checkpoint": true,
    "no_force_push_on_active_harness_branches": true,
    "clean_worktree_required_at_planned_stop": true,
    "failure_must_be_recorded_as_fix_required_or_blocked": true,
    "exact_tested_heads_required": true,
    "epoch_must_be_checked_before_dispatch_and_before_acceptance": true,
    "checkpoint_is_unit_of_control": true,
    "checkpoint_is_user_session_unit": true,
    "work_order_is_execution_unit": true,
    "role_is_isolation_unit": true,
    "role_boundary_is_not_mission_boundary": true,
    "mission_survives_role_boundaries": true,
    "user_session_exit_only_on_mission_terminal": true,
    "human_is_not_routine_result_courier": true,
    "evidence_package_is_unit_of_review": true,
    "exception_is_unit_of_human_attention": true,
    "risk_routes_review_depth": true,
    "reviewer_does_not_guess_missing_evidence": true,
    "commits_are_recovery_units_not_throughput_kpi": true,
    "proven_project_progress_is_primary_throughput": true,
    "product_train_advances_one_accepted_checkpoint_at_a_time": true,
    "successor_product_base_is_exact_accepted_predecessor_lineage": true,
    "runtime_implementation_and_closure_control_are_separate": true,
    "research_frontiers_are_non_blocking_by_default": true,
    "research_becomes_product_blocking_only_via_explicit_registered_dependency_or_proven_ownership_watch_intersection": true,
    "future_product_checkpoint_is_not_eligible_until_main_owned_activation": true,
    "active_checkpoint_mission_pre_authorizes_routine_a0_a3_git_operations": true,
    "routine_git_write_operations_are_not_human_gates": true,
    "routine_git_write_confirmation_must_not_be_reasked": true,
    "git_authority_survives_role_boundaries": true
  },
  "roles": {
    "IMPLEMENTER": "Changes code within bounded Work Order scope.",
    "REVIEWER": "Challenges design/root-cause/ownership/sibling coverage and emits PASS, FAIL or INSUFFICIENT_EVIDENCE.",
    "VERIFIER": "Independently executes required validation and confirms exact evidence.",
    "INTEGRATOR": "Checks cross-branch/composition behavior when checkpoint requires it.",
    "PC0": "Checks project architecture/convergence constraints.",
    "DIRECTOR": "Decides whether checkpoint predicates and review evidence are sufficient and activates the next product checkpoint only after predecessor acceptance.",
    "HUMAN": "Resolves explicit high-impact exceptions and approval gates."
  },
  "work_order_states": [
    "PLANNED",
    "DISPATCHED",
    "IN_PROGRESS",
    "IMPLEMENTED",
    "VERIFYING",
    "VERIFIED",
    "AUDITED",
    "CHECKPOINT_PROPOSED",
    "FIX_REQUIRED",
    "BLOCKED",
    "WAITING_HUMAN",
    "EPOCH_INVALIDATED",
    "CANCELLED"
  ],
  "autonomy_levels": {
    "A0_OBSERVE": [
      "fetch",
      "audit",
      "analyze",
      "report"
    ],
    "A1_PLAN": [
      "select_eligible_checkpoint",
      "create_work_order",
      "prepare_branch_plan",
      "classify_risk",
      "prepare_design_brief"
    ],
    "A2_IMPLEMENT": [
      "create_feature_or_control_branch",
      "create_clean_worktree",
      "edit_code",
      "test",
      "commit",
      "push"
    ],
    "A3_INTEGRATE_CANDIDATE": [
      "update_passport",
      "record_evidence",
      "open_draft_pr",
      "request_independent_review",
      "propose_source_accepted_checkpoint"
    ],
    "A4_MERGE": "HUMAN_APPROVAL_UNLESS_EXPLICITLY_WHITELISTED",
    "A5_ARCHITECTURE_PROMOTION": "HUMAN_APPROVAL_REQUIRED"
  },
  "default_autonomy_ceiling": "A3_INTEGRATE_CANDIDATE",
  "human_gates": [
    "RUNTIME_FEATURE_MERGE",
    "V0_POST_P6_SEAMLESS_ACTIVATION_OR_DEFER",
    "TS0_4_ACTIVATION_AFTER_C22_MERGE",
    "GLOBAL_ARCHITECTURE_PROMOTION",
    "FOUNDATION_OWNERSHIP_TRANSFER",
    "NEW_GLOBAL_FOUNDATION"
  ],
  "human_attention_triggers": [
    "CRITICAL_RISK",
    "ARCHITECTURE_OR_OWNERSHIP_DECISION",
    "SECURITY_OR_AUTH_CHANGE",
    "CROSS_SERVER_AUTHORITY_CHANGE",
    "UNRESOLVED_HIGH_RISK_REVIEW_DISAGREEMENT",
    "FAILED_COMPOSITION_REQUIRING_SCOPE_CHANGE",
    "DIRECTOR_REQUIRES_PRODUCT_OR_ARCHITECT_CHOICE"
  ],
  "recovery_contract": {
    "required_command_goal": "A fresh session/worktree must reconstruct active checkpoint mission, execution, epoch, branch/head, last completed predicate, open blocker, next actor/action, verification commands, review state, open human-attention items and human approvals using Git only.",
    "recovery_drill_required_before_h0_1_acceptance": true,
    "chat_dependency_is_failure": true
  },
  "throughput_metrics": [
    "accepted_checkpoints",
    "critical_path_checkpoints",
    "blockers_cleared",
    "regressions_escaped",
    "architecture_drift_findings",
    "accepted_but_not_integrated_backlog",
    "average_work_order_cycle",
    "human_decisions_required",
    "recovery_success_rate"
  ],
  "non_kpis": [
    "commits_per_day",
    "lines_changed",
    "agent_action_count_without_checkpoint_evidence"
  ],
  "commit_trailers": [
    "Project-Epoch",
    "Work-Order",
    "Predicate",
    "Work-State"
  ],
  "git_execution_authority": {
    "revision": "H0-GIT-AUTHORITY-2026-08-20-R1",
    "default_mode": "PREAUTHORIZED_WITHIN_ACTIVE_CHECKPOINT_MISSION",
    "inherits_from": "default_autonomy_ceiling",
    "routine_confirmation_required": false,
    "scope": "ACTIVE_CHECKPOINT_MISSION_AND_ACTIVE_WORK_ORDER",
    "routine_operations": [
      "fetch",
      "create_feature_or_control_branch",
      "create_clean_worktree",
      "stage_work_order_scoped_paths",
      "edit_code",
      "test",
      "commit",
      "push_non_force",
      "update_passport",
      "record_evidence",
      "post_durable_pr_comment_or_evidence",
      "open_or_update_draft_pr",
      "request_independent_review",
      "propose_source_accepted_checkpoint"
    ],
    "guards": [
      "ACTIVE_WORK_ORDER_SCOPE_ONLY",
      "NO_FORCE_PUSH",
      "NO_HISTORY_REWRITE",
      "NO_DIRECT_PUSH_TO_CANONICAL_MAIN",
      "NO_RUNTIME_MERGE_WITHOUT_DECLARED_HUMAN_GATE",
      "NO_AUTHORITY_OR_SCOPE_EXPANSION_WITHOUT_DECLARED_GATE"
    ],
    "human_confirmation_required_for": [
      "RUNTIME_FEATURE_MERGE",
      "DIRECT_PUSH_TO_CANONICAL_MAIN",
      "FORCE_PUSH",
      "HISTORY_REWRITE",
      "DELETE_REMOTE_BRANCH_WITH_UNMERGED_WORK",
      "GLOBAL_ARCHITECTURE_PROMOTION",
      "FOUNDATION_OWNERSHIP_TRANSFER",
      "NEW_GLOBAL_FOUNDATION",
      "V0_POST_P6_SEAMLESS_ACTIVATION_OR_DEFER"
    ],
    "external_tool_boundary": "If an external platform itself blocks a write pending confirmation, report EXTERNAL_TOOL_AUTH_REQUIRED. Do not misclassify that platform requirement as a Harness human gate."
  }
}
