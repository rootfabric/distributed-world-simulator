{
  "schema": "distributed_world_simulator.development_harness_policy.v1",
  "harness_revision": "H0-2026-08-11-R1",
  "review_layer_revision": "H0-REVIEW-2026-08-18-R2",
  "continuation_layer_revision": "H0-CONTINUATION-2026-08-18-R1",
  "hygiene_layer_revision": "H0-HYGIENE-2026-08-18-R1",
  "canonical_branch": "main",
  "pc0_policy": "config/control/project-control-policy.v1.json",
  "project_goals": "config/control/harness/project-goals.v1.json",
  "checkpoint_catalog": "config/control/harness/checkpoint-catalog.v1.json",
  "scheduler_policy": "config/control/harness/scheduler-policy.v1.json",
  "work_order_schema": "config/control/harness/work-order.schema.v1.json",
  "event_schema": "config/control/harness/event.schema.v1.json",
  "project_epoch_schema": "config/control/harness/project-epoch.schema.v1.json",
  "risk_policy": "config/control/harness/risk-policy.v1.json",
  "review_policy": "config/control/harness/review-policy.v1.json",
  "repair_doctrine": "config/control/harness/repair-doctrine.v1.json",
  "evidence_map_schema": "config/control/harness/evidence-map.schema.v1.json",
  "human_attention_schema": "config/control/harness/human-attention.schema.v1.json",
  "continuation_policy": "config/control/harness/continuation-policy.v1.json",
  "instruction_hygiene_policy": "config/control/harness/instruction-hygiene-policy.v1.json",
  "rule_registry": "config/control/harness/rule-registry.v1.json",
  "principles": {
    "git_is_durable_memory": true,
    "chat_history_is_not_required_for_resume": true,
    "main_owns_goals_policy_and_project_state": true,
    "branches_report_execution_facts": true,
    "events_are_append_only": true,
    "derived_status_is_rebuildable": true,
    "implementer_cannot_self_accept_checkpoint": true,
    "one_atomic_predicate_per_commit_when_practical": true,
    "push_after_each_durable_atomic_checkpoint": true,
    "no_force_push_on_active_harness_branches": true,
    "clean_worktree_required_at_planned_stop": true,
    "failure_must_be_recorded_as_fix_required_or_blocked": true,
    "exact_tested_heads_required": true,
    "epoch_must_be_checked_before_dispatch_and_before_acceptance": true,
    "checkpoint_is_unit_of_control": true,
    "evidence_package_is_unit_of_review": true,
    "exception_is_unit_of_human_attention": true,
    "risk_routes_review_depth": true,
    "reviewer_does_not_guess_missing_evidence": true,
    "commits_are_recovery_units_not_throughput_kpi": true,
    "proven_project_progress_is_primary_throughput": true,
    "mission_survives_role_boundaries": true,
    "routine_role_handoff_is_not_human_gate": true,
    "human_is_not_routine_result_courier": true,
    "role_result_must_be_durable_before_transition": true,
    "chat_only_review_verdict_is_non_authoritative": true,
    "next_transition_must_be_machine_described": true,
    "machine_enforcement_displaces_duplicate_prose": true,
    "protected_invariants_are_not_auto_retired": true
  },
  "roles": {
    "IMPLEMENTER": "Changes code within bounded Work Order scope.",
    "REVIEWER": "Challenges design/root-cause/ownership/sibling coverage and persists PASS, FAIL or INSUFFICIENT_EVIDENCE to the declared durable evidence sink.",
    "VERIFIER": "Independently executes required validation and confirms exact evidence.",
    "INTEGRATOR": "Checks cross-branch/composition behavior when checkpoint requires it.",
    "PC0": "Checks project architecture/convergence constraints.",
    "DIRECTOR": "Maintains mission continuity and decides whether checkpoint predicates and durable review evidence are sufficient.",
    "HUMAN": "Resolves explicit high-impact exceptions and approval gates; is not a courier between routine agent roles."
  },
  "work_order_states": ["PLANNED","DISPATCHED","IN_PROGRESS","IMPLEMENTED","VERIFYING","VERIFIED","AUDITED","CHECKPOINT_PROPOSED","FIX_REQUIRED","BLOCKED","WAITING_HUMAN","EPOCH_INVALIDATED","CANCELLED"],
  "autonomy_levels": {
    "A0_OBSERVE": ["fetch","audit","analyze","report"],
    "A1_PLAN": ["select_eligible_checkpoint","create_work_order","prepare_branch_plan","classify_risk","prepare_design_brief"],
    "A2_IMPLEMENT": ["create_feature_or_control_branch","create_clean_worktree","edit_code","test","commit","push"],
    "A3_INTEGRATE_CANDIDATE": ["update_passport","record_evidence","open_draft_pr","request_independent_review","propose_source_accepted_checkpoint"],
    "A4_MERGE": "HUMAN_APPROVAL_UNLESS_EXPLICITLY_WHITELISTED",
    "A5_ARCHITECTURE_PROMOTION": "HUMAN_APPROVAL_REQUIRED"
  },
  "default_autonomy_ceiling": "A3_INTEGRATE_CANDIDATE",
  "human_gates": ["RUNTIME_FEATURE_MERGE","TS0_4_ACTIVATION_AFTER_C22_MERGE","GLOBAL_ARCHITECTURE_PROMOTION","FOUNDATION_OWNERSHIP_TRANSFER","NEW_GLOBAL_FOUNDATION"],
  "human_attention_triggers": ["CRITICAL_RISK","ARCHITECTURE_OR_OWNERSHIP_DECISION","SECURITY_OR_AUTH_CHANGE","CROSS_SERVER_AUTHORITY_CHANGE","UNRESOLVED_HIGH_RISK_REVIEW_DISAGREEMENT","FAILED_COMPOSITION_REQUIRING_SCOPE_CHANGE","DIRECTOR_REQUIRES_PRODUCT_OR_ARCHITECT_CHOICE"],
  "recovery_contract": {
    "required_command_goal": "A fresh session/worktree must reconstruct active epoch, branch/head, parent mission, last completed predicate, open blocker, next actor/action, evidence sink, resume condition, verification commands, review state, open human-attention items and human approvals using durable repository/control evidence only.",
    "recovery_drill_required_before_h0_1_acceptance": true,
    "chat_dependency_is_failure": true
  },
  "throughput_metrics": ["accepted_checkpoints","critical_path_checkpoints","blockers_cleared","regressions_escaped","architecture_drift_findings","accepted_but_not_integrated_backlog","average_work_order_cycle","human_decisions_required","recovery_success_rate"],
  "non_kpis": ["commits_per_day","lines_changed","agent_action_count_without_checkpoint_evidence"],
  "commit_trailers": ["Project-Epoch","Work-Order","Predicate","Work-State"]
}
