{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "distributed_world_simulator.harness_human_attention.schema.v1",
  "title": "Distributed World Simulator Human Attention Item",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "decision_id", "program", "checkpoint", "risk_class", "reason", "decision_required", "options", "blast_radius", "status"],
  "properties": {
    "schema": {"const": "distributed_world_simulator.harness_human_attention.v1"},
    "decision_id": {"type": "string", "minLength": 1},
    "program": {"type": "string", "minLength": 1},
    "checkpoint": {"type": "string", "minLength": 1},
    "risk_class": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "reason": {"type": "string", "minLength": 1},
    "decision_required": {"type": "string", "minLength": 1},
    "options": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "recommended_option": {"type": "string"},
    "recommendation_reason": {"type": "string"},
    "blast_radius": {"type": "array", "items": {"type": "string"}},
    "blocking": {"type": "boolean"},
    "evidence_paths": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["OPEN", "RESOLVED", "SUPERSEDED", "CANCELLED"]},
    "resolution": {"type": "string"}
  }
}
