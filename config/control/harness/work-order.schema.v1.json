{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "distributed_world_simulator.work_order.schema.v1",
  "title": "Distributed World Simulator Harness Work Order",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","work_order_id","project_epoch","program","goal_checkpoint","state","work_order_type","base_sha","branch","scope","allowed_paths","forbidden_paths","required_predicates","required_outputs","stop_conditions","risk_class","review_required","evidence_map_required","issued_at_utc"],
  "properties": {
    "schema": {"const": "distributed_world_simulator.work_order.v1"},
    "work_order_id": {"type":"string","minLength":1},
    "project_epoch": {"type":"string","minLength":1},
    "program": {"type":"string","minLength":1},
    "goal_checkpoint": {"type":"string","minLength":1},
    "state": {"enum":["PLANNED","DISPATCHED","IN_PROGRESS","IMPLEMENTED","VERIFYING","VERIFIED","AUDITED","CHECKPOINT_PROPOSED","FIX_REQUIRED","BLOCKED","WAITING_HUMAN","EPOCH_INVALIDATED","CANCELLED"]},
    "work_order_type": {"enum":["IMPLEMENTATION","VALIDATION","CONTROL","HUMAN_OBSERVATION","RECOVERY","FIX","REVIEW","INTEGRATION"]},
    "base_sha": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "branch": {"type":"string","minLength":1},
    "scope": {"type":"string","minLength":1},
    "allowed_paths": {"type":"array","items":{"type":"string"}},
    "forbidden_paths": {"type":"array","items":{"type":"string"}},
    "required_predicates": {"type":"array","items":{"type":"string"}},
    "required_outputs": {"type":"array","items":{"type":"string"}},
    "stop_conditions": {"type":"array","items":{"type":"string"}},
    "risk_class": {"enum":["LOW","MEDIUM","HIGH","CRITICAL"]},
    "risk_reasons": {"type":"array","items":{"type":"string"}},
    "review_required": {"type":"boolean"},
    "required_review_roles": {"type":"array","items":{"enum":["IMPLEMENTER","REVIEWER","VERIFIER","INTEGRATOR","DIRECTOR","HUMAN"]}},
    "design_brief": {"type":"object","additionalProperties":false,"properties":{"problem_statement":{"type":"string"},"current_behavior":{"type":"string"},"desired_behavior":{"type":"string"},"alternatives_considered":{"type":"array","items":{"type":"string"}},"selected_design":{"type":"string"},"why_selected":{"type":"string"},"affected_owners":{"type":"array","items":{"type":"string"}},"dependencies":{"type":"array","items":{"type":"string"}},"non_goals":{"type":"array","items":{"type":"string"}},"expected_risks":{"type":"array","items":{"type":"string"}},"validation_plan":{"type":"array","items":{"type":"string"}}}},
    "mission": {"type":"object","additionalProperties":false,"required":["mission_id","objective"],"properties":{"mission_id":{"type":"string","minLength":1},"objective":{"type":"string","minLength":1},"parent_mission_id":{"type":["string","null"]},"completion_condition":{"type":"string","minLength":1}}},
    "handoff": {"type":"object","additionalProperties":false,"properties":{"review_evidence_sink":{"enum":["EXECUTION_LEDGER","GITHUB_PR_REVIEW"]},"on_review_pass":{"type":"string","minLength":1},"on_review_fail":{"type":"string","minLength":1},"on_review_insufficient_evidence":{"type":"string","minLength":1}}},
    "repair_context_required": {"type":"boolean"},
    "evidence_map_required": {"type":"boolean"},
    "human_attention_triggers": {"type":"array","items":{"type":"string"}},
    "issued_at_utc": {"type":"string","format":"date-time"},
    "human_approval_required_for": {"type":"array","items":{"type":"string"}},
    "notes": {"type":"string"}
  }
}
