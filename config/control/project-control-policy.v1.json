{
  "schema": "distributed_world_simulator.project_control_policy.v1",
  "control_plane_revision": "PC0-2026-08-10-R1",
  "architecture_revision": "GLOBAL-P0-2026-08-10-R2",
  "canonical_branch": "main",
  "operational_frontier_source": "config/control/project-program-registry.v1.json",
  "legacy_global_active_frontiers_policy": "GLOBAL-P0-R2 active_frontiers fields are advisory legacy state until the next global architecture revision; PC0 registry is authoritative for fast-moving operational frontier state.",
  "central_registry_path": "config/control/project-program-registry.v1.json",
  "ownership_matrix_path": "config/control/architecture-ownership.v1.json",
  "dashboard_entrypoint": "PROJECT_CONTROL.md",
  "agent_router": "AGENTS.md",
  "auditor": "scripts/control/project_control.py",
  "directional_watch_auditor": "scripts/control/project_control_directional_watch.py",
  "development_harness": {
    "revision": "H0-2026-08-11-R1",
    "review_layer_revision": "H0-REVIEW-2026-08-11-R1",
    "protocol": "docs/control/DEVELOPMENT_HARNESS_RU.md",
    "review_protocol": "docs/control/HARNESS_REVIEW_AND_EVIDENCE_RU.md",
    "project_goals": "config/control/harness/project-goals.v1.json",
    "checkpoint_catalog": "config/control/harness/checkpoint-catalog.v1.json",
    "harness_policy": "config/control/harness/harness-policy.v1.json",
    "scheduler_policy": "config/control/harness/scheduler-policy.v1.json",
    "risk_policy": "config/control/harness/risk-policy.v1.json",
    "review_policy": "config/control/harness/review-policy.v1.json",
    "repair_doctrine": "config/control/harness/repair-doctrine.v1.json",
    "evidence_map_schema": "config/control/harness/evidence-map.schema.v1.json",
    "human_attention_schema": "config/control/harness/human-attention.schema.v1.json"
  },
  "rules": {
    "main_declares_project_state": true,
    "branches_report_local_facts": true,
    "one_primary_frontier_per_program": true,
    "parallel_tracks_must_be_registered": true,
    "historical_accepted_branches_are_not_rewritten_for_status_only_changes": true,
    "status_updates_do_not_require_global_architecture_revision": true,
    "global_architecture_changes_must_start_in_main": true,
    "branch_must_declare_description_purpose_outcome_and_stage": true,
    "branch_must_declare_owned_and_watched_paths": true,
    "branch_must_declare_forbidden_foundation_ownership": true,
    "two_major_acceptance_steps_require_intermediate_control_audit": true,
    "tested_runtime_must_not_be_older_than_runtime_changes": true,
    "active_branch_changes_watched_dependency_requires_directional_audit": true,
    "human_prose_drift_is_not_a_correctness_failure": true,
    "research_design_frontiers_are_advisory_to_global_health": true,
    "research_design_frontier_promotion_still_requires_full_merge_gates": true,
    "harness_must_select_declared_checkpoint_not_open_ended_task": true,
    "harness_resume_must_not_require_chat_history": true,
    "harness_implementer_cannot_self_accept_checkpoint": true,
    "harness_epoch_required_for_autonomous_runtime_work": true,
    "harness_execution_events_are_append_only_in_worker_branch": true,
    "harness_default_autonomy_stops_before_runtime_merge": true,
    "harness_runtime_work_requires_risk_classification": true,
    "harness_medium_plus_requires_design_brief": true,
    "harness_fix_required_medium_plus_requires_repair_map": true,
    "harness_runtime_checkpoint_requires_evidence_map": true,
    "harness_runtime_checkpoint_requires_independent_review": true,
    "harness_missing_review_evidence_is_not_assumed_pass": true,
    "harness_review_head_must_be_fresh_for_runtime_scope": true,
    "harness_human_attention_is_exception_driven": true,
    "commits_per_day_is_not_project_throughput": true
  },
  "global_health_semantics": {
    "default_program_gate": "BLOCKING",
    "non_blocking_roles": ["RESEARCH_DESIGN_FRONTIER"],
    "registry_override_field": "blocks_global_progress",
    "advisory_behavior": "Keep full local health/findings visible, but do not raise project-wide overall_health from that program alone.",
    "promotion_boundary": "A research/design frontier becomes subject to normal blocking merge/dependency/review gates when it is explicitly promoted toward canonical or runtime scope.",
    "directional_exception": "A research producer that touches paths watched by a blocking consumer can still make that blocking consumer YELLOW/RED; only findings whose consumer is advisory are excluded from directional overall_health."
  },
  "passport_architecture_compatibility": {
    "mode": "EXPLICIT_PER_PROGRAM_HISTORICAL_ALLOWLIST",
    "central_registry_field": "historical_passport_architecture_revisions",
    "historical_identity_registry_field": "historical_passport_identities",
    "exact_canonical_revision_always_allowed": true,
    "historical_revision_requires_explicit_main_registry_declaration": true,
    "historical_identity_required_for_mismatch": true,
    "historical_identity_required_fields": [
      "program",
      "branch",
      "passport_path",
      "architecture_revision",
      "pinned_head_sha",
      "passport_blob_sha"
    ],
    "historical_mismatch_requires": [
      "revision_allowlist",
      "exact_immutable_identity_match"
    ],
    "missing_or_malformed_allowlist_fails_closed": true,
    "missing_or_malformed_historical_identity_fails_closed": true,
    "historical_allowlist_is_provenance_only": true,
    "new_or_refreshed_post_promotion_frontiers_must_use_canonical_revision": true,
    "rule": "A Branch Passport whose architecture_revision differs from the canonical registry remains RED unless the main-owned policy explicitly names both historical registry fields, the exact historical revision is allowlisted for the audited program, and exactly one historical_passport_identities record matches the exact program, branch, passport_path, historical architecture revision, observed remote branch head, and observed passport blob SHA. Revision allowlist membership alone never authorizes a mismatch. Missing, malformed, moved, copied, refreshed, or ambiguous identity evidence fails closed. No role, stage, blocker, status, or branch-name heuristic may grant compatibility."
  },
  "passport_ownership_compatibility": {
    "mode": "EXPLICIT_PER_PROGRAM_HISTORICAL_OWNERSHIP_TRANSITIONS",
    "central_registry_field": "historical_passport_ownership_transitions",
    "architecture_compatibility_prerequisite": "EXPLICIT_HISTORICAL_IDENTITY_ALLOWED",
    "historical_canonical_ownership_source": {
      "architecture_revision": "GLOBAL-P0-2026-08-10-R2",
      "commit_sha": "ce40dd075045078ed70924f8d5a1011eb3eff03d",
      "path": "config/control/architecture-ownership.v1.json",
      "blob_sha": "0cebf594ac7900292318d7533e4439cc7f3764d6"
    },
    "required_transition_fields": [
      "program",
      "architecture_revision",
      "foundation",
      "historical_owner",
      "canonical_owner"
    ],
    "forbidden_compatibility_heuristics": [
      "role",
      "current_stage",
      "stage_status",
      "health_declared",
      "blockers",
      "branch_name_pattern"
    ],
    "missing_or_malformed_policy_fails_closed": true,
    "missing_or_malformed_transition_fails_closed": true,
    "duplicate_matching_transition_fails_closed": true,
    "wildcard_transition_forbidden": true,
    "new_or_refreshed_frontiers_must_not_use_historical_ownership_compatibility": true,
    "rule": "Historical foundation ownership conflicts may be filtered only after exact immutable historical architecture identity compatibility is already proven, and only when exactly one per-program, per-foundation transition matches the historical passport claim, the pinned canonical R2 ownership source, and the current canonical ownership owner. Missing, malformed, wildcard, duplicated, moved, copied, refreshed, or non-exact evidence fails closed. No role, stage, status, blocker, or branch-name heuristic grants ownership compatibility."
  },
  "branch_lifecycle": [
    "PLANNED",
    "ACTIVE",
    "IMPLEMENTED_CANDIDATE",
    "FIX_REQUIRED",
    "ACCEPTED",
    "SUPERSEDED",
    "FROZEN"
  ],
  "health_levels": {
    "GREEN": "Development may continue. No blocking control-plane inconsistency is known.",
    "YELLOW": "Development may continue, but a convergence/control review is required before the next major acceptance.",
    "RED": "The next declared stage or acceptance is blocked until the listed control issue is resolved."
  },
  "required_branch_passport_fields": [
    "schema",
    "control_plane_revision",
    "architecture_revision",
    "branch",
    "program",
    "role",
    "short_description",
    "purpose",
    "expected_outcome",
    "current_stage",
    "stage_status",
    "progress_note",
    "last_accepted_checkpoint",
    "next_stage",
    "parent_branch_or_checkpoint",
    "base_commit",
    "dependencies",
    "owned_paths",
    "watched_paths",
    "critical_watched_paths",
    "runtime_paths",
    "validation_paths",
    "tested_heads",
    "ownership_claims",
    "forbidden_foundation_ownership",
    "blockers",
    "health_declared"
  ],
  "central_registry_mirror_fields": [
    "branch",
    "program",
    "role",
    "current_stage",
    "stage_status",
    "blockers",
    "health_declared"
  ],
  "central_registry_informational_fields": [
    "short_description",
    "purpose",
    "expected_outcome",
    "progress_note",
    "last_accepted_checkpoint",
    "next_stage"
  ],
  "overlap_policy": {
    "ignored_patterns": [
      "PROJECT_CONTROL.md",
      "HARNESS_CONTROL.md",
      "AGENTS.md",
      "CONTROL_PROJECT.ps1",
      "scripts/control/**",
      "config/control/**",
      "docs/control/**",
      ".github/workflows/project-control.yml",
      "config/architecture/global-program-roadmap.v1.json",
      "docs/plans/GLOBAL_PROGRAM_ARCHITECTURE_ROADMAP_RU.md",
      "config/network/network-experience-roadmap.v1.json"
    ],
    "yellow_patterns": [
      "docs/**",
      "validation/**"
    ],
    "same_runtime_or_contract_file_in_two_active_branches": "RED"
  },
  "directional_watch_policy": {
    "watched_hit_health": "YELLOW",
    "critical_hit_health": "RED",
    "producer_suppression_stage_statuses": [
      "SOURCE_ACCEPTED_HANDOFF_COMPLETE"
    ],
    "rule": "An active producer branch changing a path matched by another registered branch's watched_paths makes the consumer YELLOW; critical_watched_paths makes the consumer RED. Accepted handoff evidence remains a consumer but is suppressed as a producer. RESEARCH_DESIGN_FRONTIER consumers are advisory to global health until explicit promotion; research producers can still affect blocking consumers."
  },
  "merge_gate": [
    "BRANCH_REGISTERED",
    "BRANCH_PASSPORT_PRESENT",
    "CENTRAL_AND_BRANCH_IDENTITY_MATCH",
    "ARCHITECTURE_REVISION_MATCH",
    "PARENT_CHECKPOINT_VALID",
    "NO_DUPLICATE_FOUNDATION_OWNERSHIP",
    "NO_UNRESOLVED_CRITICAL_DEPENDENCY_DRIFT",
    "NO_UNRESOLVED_CRITICAL_DIRECTIONAL_WATCH_HIT",
    "NO_UNRESOLVED_CRITICAL_CROSS_BRANCH_OVERLAP",
    "RUNTIME_VALIDATION_FRESH",
    "REVIEW_EVIDENCE_COMPLETE_WHEN_REQUIRED",
    "REVIEW_HEAD_FRESH_WHEN_REQUIRED",
    "NO_BLOCKING_HUMAN_ATTENTION_ITEM",
    "FOCUSED_VALIDATION_PASS",
    "REQUIRED_REGRESSION_PASS",
    "STATUS_DIMENSIONS_REMAIN_DISTINCT"
  ]
}
