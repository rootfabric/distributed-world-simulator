{
  "schema": "distributed_world_simulator.project_control_policy.v1",
  "control_plane_revision": "PC0-2026-08-10-R1",
  "architecture_revision": "GLOBAL-P0-2026-08-10-R2",
  "canonical_branch": "main",
  "operational_frontier_source": "config/control/project-program-registry.v1.json",
  "legacy_global_active_frontiers_policy": "GLOBAL-P0-R2 active_frontiers fields are advisory legacy state until the next global architecture revision; PC0 registry is authoritative for fast-moving operational frontier state.",
  "central_registry_path": "config/control/project-program-registry.v1.json",
  "ownership_matrix_path": "config/control/architecture-ownership.v1.json",
  "dashboard_entrypoint": "PROJECT_CONTROL.md",
  "auditor": "scripts/control/project_control.py",
  "directional_watch_auditor": "scripts/control/project_control_directional_watch.py",
  "development_harness": {
    "revision": "H0-2026-08-11-R1",
    "protocol": "docs/control/DEVELOPMENT_HARNESS_RU.md",
    "project_goals": "config/control/harness/project-goals.v1.json",
    "checkpoint_catalog": "config/control/harness/checkpoint-catalog.v1.json",
    "harness_policy": "config/control/harness/harness-policy.v1.json",
    "scheduler_policy": "config/control/harness/scheduler-policy.v1.json"
  },
  "rules": {
    "main_declares_project_state": true,
    "branches_report_local_facts": true,
    "one_primary_frontier_per_program": true,
    "parallel_tracks_must_be_registered": true,
    "historical_accepted_branches_are_not_rewritten_for_status_only_changes": true,
    "status_updates_do_not_require_global_architecture_revision": true,
    "global_architecture_changes_must_start_in_main": true,
    "branch_must_declare_description_purpose_outcome_and_stage": true,
    "branch_must_declare_owned_and_watched_paths": true,
    "branch_must_declare_forbidden_foundation_ownership": true,
    "two_major_acceptance_steps_require_intermediate_control_audit": true,
    "tested_runtime_must_not_be_older_than_runtime_changes": true,
    "active_branch_changes_watched_dependency_requires_directional_audit": true,
    "human_prose_drift_is_not_a_correctness_failure": true,
    "harness_must_select_declared_checkpoint_not_open_ended_task": true,
    "harness_resume_must_not_require_chat_history": true,
    "harness_implementer_cannot_self_accept_checkpoint": true,
    "harness_epoch_required_for_autonomous_runtime_work": true,
    "harness_execution_events_are_append_only_in_worker_branch": true,
    "harness_default_autonomy_stops_before_runtime_merge": true
  },
  "branch_lifecycle": [
    "PLANNED",
    "ACTIVE",
    "IMPLEMENTED_CANDIDATE",
    "FIX_REQUIRED",
    "ACCEPTED",
    "SUPERSEDED",
    "FROZEN"
  ],
  "health_levels": {
    "GREEN": "Development may continue. No blocking control-plane inconsistency is known.",
    "YELLOW": "Development may continue, but a convergence/control review is required before the next major acceptance.",
    "RED": "The next declared stage or acceptance is blocked until the listed control issue is resolved."
  },
  "required_branch_passport_fields": [
    "schema",
    "control_plane_revision",
    "architecture_revision",
    "branch",
    "program",
    "role",
    "short_description",
    "purpose",
    "expected_outcome",
    "current_stage",
    "stage_status",
    "progress_note",
    "last_accepted_checkpoint",
    "next_stage",
    "parent_branch_or_checkpoint",
    "base_commit",
    "dependencies",
    "owned_paths",
    "watched_paths",
    "critical_watched_paths",
    "runtime_paths",
    "validation_paths",
    "tested_heads",
    "ownership_claims",
    "forbidden_foundation_ownership",
    "blockers",
    "health_declared"
  ],
  "central_registry_mirror_fields": [
    "branch",
    "program",
    "role",
    "current_stage",
    "stage_status",
    "blockers",
    "health_declared"
  ],
  "central_registry_informational_fields": [
    "short_description",
    "purpose",
    "expected_outcome",
    "progress_note",
    "last_accepted_checkpoint",
    "next_stage"
  ],
  "overlap_policy": {
    "ignored_patterns": [
      "PROJECT_CONTROL.md",
      "CONTROL_PROJECT.ps1",
      "scripts/control/**",
      "config/control/**",
      "docs/control/**",
      ".github/workflows/project-control.yml",
      "config/architecture/global-program-roadmap.v1.json",
      "docs/plans/GLOBAL_PROGRAM_ARCHITECTURE_ROADMAP_RU.md",
      "config/network/network-experience-roadmap.v1.json"
    ],
    "yellow_patterns": [
      "docs/**",
      "validation/**"
    ],
    "same_runtime_or_contract_file_in_two_active_branches": "RED"
  },
  "directional_watch_policy": {
    "watched_hit_health": "YELLOW",
    "critical_hit_health": "RED",
    "producer_suppression_stage_statuses": [
      "SOURCE_ACCEPTED_HANDOFF_COMPLETE"
    ],
    "rule": "An active producer branch changing a path matched by another registered branch's watched_paths makes the consumer YELLOW; critical_watched_paths makes the consumer RED. Accepted handoff evidence remains a consumer but is suppressed as a producer."
  },
  "merge_gate": [
    "BRANCH_REGISTERED",
    "BRANCH_PASSPORT_PRESENT",
    "CENTRAL_AND_BRANCH_IDENTITY_MATCH",
    "ARCHITECTURE_REVISION_MATCH",
    "PARENT_CHECKPOINT_VALID",
    "NO_DUPLICATE_FOUNDATION_OWNERSHIP",
    "NO_UNRESOLVED_CRITICAL_DEPENDENCY_DRIFT",
    "NO_UNRESOLVED_CRITICAL_DIRECTIONAL_WATCH_HIT",
    "NO_UNRESOLVED_CRITICAL_CROSS_BRANCH_OVERLAP",
    "RUNTIME_VALIDATION_FRESH",
    "FOCUSED_VALIDATION_PASS",
    "REQUIRED_REGRESSION_PASS",
    "STATUS_DIMENSIONS_REMAIN_DISTINCT"
  ]
}
