{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://distributed-world-simulator.invalid/schema/ecology/evo3/e3-4-causal-colonization-program.v1.json",
  "title": "ECO EVO3 E3.4 Causal Colonization Program",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","version","checkpoint","compiler_stage","authority","canonical_binding_resolved","production_binding_authorized","source_decomposition","source_catalog","input_species_manifest","source_port","causal_thresholds","species_programs","colonization_result","summary","provenance","provenance_hash","colonization_program_hash_algorithm","colonization_program_hash"],
  "properties": {
    "schema":{"const":"distributed_world_simulator.ecology.evo3_e3_4_causal_colonization_program.v1"},
    "version":{"const":"1.0.0"},
    "checkpoint":{"const":"ECO.EVO3/E3.4"},
    "compiler_stage":{"const":"COLONIZATION_PROGRAM"},
    "authority":{"const":"RESEARCH_DERIVED_NON_AUTHORITATIVE"},
    "canonical_binding_resolved":{"const":false},
    "production_binding_authorized":{"const":false},
    "source_decomposition":{"type":"object","additionalProperties":false,"required":["decomposition_hash","decomposition_provenance_hash","stable_planet_identity","stable_time_key","patch_count","edge_count","region_count"],"properties":{"decomposition_hash":{"$ref":"#/$defs/hex64"},"decomposition_provenance_hash":{"$ref":"#/$defs/hex64"},"stable_planet_identity":{"type":"string","minLength":1},"stable_time_key":{"type":"string","minLength":1},"patch_count":{"type":"integer","minimum":1},"edge_count":{"type":"integer","minimum":0},"region_count":{"type":"integer","minimum":1}}},
    "source_catalog":{"type":"object","additionalProperties":false,"required":["catalog_hash","bake_id","source_run_hash","entry_count","transport_sha256","transport_bytes"],"properties":{"catalog_hash":{"$ref":"#/$defs/hex64"},"bake_id":{"type":"string","minLength":1},"source_run_hash":{"$ref":"#/$defs/hex64"},"entry_count":{"type":"integer","minimum":0},"transport_sha256":{"$ref":"#/$defs/hex64"},"transport_bytes":{"type":"integer","minimum":1}}},
    "input_species_manifest":{"type":"array","items":{"$ref":"#/$defs/speciesManifest"}},
    "source_port":{"type":"object","additionalProperties":false,"required":["selection","research_patch_id","stable_spatial_key","species_entry_count","species_ids"],"properties":{"selection":{"const":"LEXICOGRAPHICALLY_LOWEST_STABLE_SPATIAL_KEY_V1"},"research_patch_id":{"type":"string","minLength":1},"stable_spatial_key":{"type":"string","minLength":1},"species_entry_count":{"type":"integer","minimum":0},"species_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}}},
    "causal_thresholds":{"type":"object","additionalProperties":false,"required":["minimum_establishment_ppm","minimum_edge_arrival_ppm"],"properties":{"minimum_establishment_ppm":{"$ref":"#/$defs/ppm"},"minimum_edge_arrival_ppm":{"$ref":"#/$defs/ppm"}}},
    "species_programs":{"type":"array","items":{"$ref":"#/$defs/speciesProgram"}},
    "colonization_result":{"enum":["COLONIZATION_PRESENT","NO_COLONIZATION"]},
    "summary":{"type":"object","additionalProperties":false,"required":["input_species_count","colonized_species_count","filtered_species_count","colonized_patch_count","total_species_patch_establishments","no_colonization"],"properties":{"input_species_count":{"type":"integer","minimum":0},"colonized_species_count":{"type":"integer","minimum":0},"filtered_species_count":{"type":"integer","minimum":0},"colonized_patch_count":{"type":"integer","minimum":0},"total_species_patch_establishments":{"type":"integer","minimum":0},"no_colonization":{"type":"boolean"}}},
    "provenance":{"type":"object","additionalProperties":false,"required":["contract_hash","accepted_e3_3_merge_commit","accepted_e3_3_decomposition_hash","accepted_e3_3_decomposition_provenance_hash","persisted_evo2_catalog_hash","persisted_evo2_catalog_semantic_artifact_sha256","persisted_evo2_transport_sha256","e2_final_aggregate_hash","historical_eco_anchor"],"properties":{"contract_hash":{"$ref":"#/$defs/hex64"},"accepted_e3_3_merge_commit":{"$ref":"#/$defs/hex40"},"accepted_e3_3_decomposition_hash":{"$ref":"#/$defs/hex64"},"accepted_e3_3_decomposition_provenance_hash":{"$ref":"#/$defs/hex64"},"persisted_evo2_catalog_hash":{"$ref":"#/$defs/hex64"},"persisted_evo2_catalog_semantic_artifact_sha256":{"$ref":"#/$defs/hex64"},"persisted_evo2_transport_sha256":{"$ref":"#/$defs/hex64"},"e2_final_aggregate_hash":{"$ref":"#/$defs/hex64"},"historical_eco_anchor":{"$ref":"#/$defs/hex40"}}},
    "provenance_hash":{"$ref":"#/$defs/hex64"},
    "colonization_program_hash_algorithm":{"const":"SHA256_CANONICAL_JSON_SORTED_KEYS_V1"},
    "colonization_program_hash":{"$ref":"#/$defs/hex64"}
  },
  "$defs": {
    "hex64":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "hex40":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "ppm":{"type":"integer","minimum":0,"maximum":1000000},
    "speciesManifest":{"type":"object","additionalProperties":false,"required":["research_species_id","lineage_id","entry_hash","genome_checksum","recruitment_traits_checksum","source_observation_hash"],"properties":{"research_species_id":{"type":"string","pattern":"^eco-research-species/[0-9a-f]{24}$"},"lineage_id":{"type":"string","minLength":1},"entry_hash":{"$ref":"#/$defs/hex64"},"genome_checksum":{"$ref":"#/$defs/hex64"},"recruitment_traits_checksum":{"$ref":"#/$defs/hex64"},"source_observation_hash":{"$ref":"#/$defs/hex64"}}},
    "patchEvaluation":{"type":"object","additionalProperties":false,"required":["research_patch_id","stable_spatial_key","establishment_score_ppm","arrival_pressure_ppm","route_edge_id","route_origin_patch_id","decision"],"properties":{"research_patch_id":{"type":"string","minLength":1},"stable_spatial_key":{"type":"string","minLength":1},"establishment_score_ppm":{"$ref":"#/$defs/ppm"},"arrival_pressure_ppm":{"$ref":"#/$defs/ppm"},"route_edge_id":{"type":"string"},"route_origin_patch_id":{"type":"string"},"decision":{"enum":["ESTABLISHED","ESTABLISHMENT_REJECTED","DISPERSAL_REJECTED","UNREACHABLE"]}}},
    "speciesProgram":{"type":"object","additionalProperties":false,"required":["research_species_id","lineage_id","entry_hash","source_port_patch_id","dispersal_capacity_ppm","establishment_trait_support_ppm","patch_evaluations","established_patch_ids","status"],"properties":{"research_species_id":{"type":"string","pattern":"^eco-research-species/[0-9a-f]{24}$"},"lineage_id":{"type":"string","minLength":1},"entry_hash":{"$ref":"#/$defs/hex64"},"source_port_patch_id":{"type":"string","minLength":1},"dispersal_capacity_ppm":{"$ref":"#/$defs/ppm"},"establishment_trait_support_ppm":{"$ref":"#/$defs/ppm"},"patch_evaluations":{"type":"array","items":{"$ref":"#/$defs/patchEvaluation"}},"established_patch_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"status":{"enum":["COLONIZED","NO_COLONIZATION"]}}}
  }
}
