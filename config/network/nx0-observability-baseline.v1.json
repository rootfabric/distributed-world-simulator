  "purpose": "Attach mandatory build/protocol/world/session compatibility verification and bounded transport/runtime telemetry to the production M3/M7 ENet path before any NX2 traffic changes.",
  "compatibility_gate": {
    "position": "after ENet transport connection and before JOIN",
    "client_message": "COMPATIBILITY_HELLO",
    "server_accept": "COMPATIBILITY_ACK",
    "server_reject": "COMPATIBILITY_REJECTED",
    "required_matches": [
      "build_id",
      "git_commit",
      "protocol_hash",
      "world_id",
      "session_token"
    ],
    "deterministic_errors": [
      "BUILD_ID_MISMATCH",
      "GIT_COMMIT_MISMATCH",
      "PROTOCOL_HASH_MISMATCH",
      "WORLD_ID_MISMATCH",
      "SESSION_TOKEN_MISMATCH",
      "FINGERPRINT_REQUIRED"
    ],
    "replay_policy": "Matching HELLO replay is idempotently ACKed and counted without a second gameplay join."
  },
  "session_token_policy": {
    "allowed_public_id_format": "session-id/<public-id>",
    "allowed_digest_format": "sha256/<64-lowercase-hex>",
    "raw_credentials_forbidden": true
  },
  "telemetry": {
    "transport": [
