  "inputs": [
    "geo/surface-height-m",
    "geo/valley-influence",
    "geo/river-distance-m",
    "geo/river-width-m"
  ],
  "zone_geometry": {
    "normalization": "normalized_distance = river_distance_m / (river_width_m * 0.5)",
    "channel": [0.0, 1.0],
    "bank_inner": 1.0,
    "bank_peak": 1.5,
    "bank_outer": 2.0,
    "floodplain_inner": 2.0,
    "floodplain_full": 2.5,
    "floodplain_core_end": 4.5,
    "floodplain_outer": 6.0
  },
  "formula": {
    "bank_weight": "cubic smooth rise/fall from normalized distance 1.0 -> 1.5 -> 2.0",
    "bank_delta_m": "+bank_max_delta_m * bank_weight * valley_influence",
    "floodplain_weight": "cubic entry 2.0 -> 2.5, full core 2.5 -> 4.5, cubic fade 4.5 -> 6.0",
    "floodplain_delta_m": "-floodplain_max_delta_m * floodplain_weight * valley_influence"
  },
  "rules": {
    "inside_channel_bank_zero": true,
    "inside_channel_floodplain_zero": true,
    "bank_positive_or_zero": true,
    "floodplain_non_positive": true,
    "bank_profile_bounded": true,
    "floodplain_profile_bounded": true,
    "valley_influence_modulates_both": true,
    "zero_valley_influence_suppresses_both": true,
    "preserves_g8_2_valley_component": true,
    "preserves_g8_2_river_component": true,
    "erosion_deposition_component_zero": true,
    "same_bundle_used_for_parent_and_shaping": true,
    "output_binds_source_bundle_checksum": true,
    "output_binds_profile_checksum": true,
    "deterministic": true
  },
  "semantic_note": "G8.3 deliberately does not use geo/fluid-surface-distance-m as an absolute water elevation because the accepted G7 descriptor exposes only distance to the nearest fluid surface, not a signed canonical water-level height. Banks and floodplain therefore use only accepted river centerline/width geometry plus valley influence.",
