From 7aaa7fa9ebcabeeca33f15696002ff3907c22ffb Mon Sep 17 00:00:00 2001
From: CONTROL <control@nanolab.local>
Date: Wed, 21 Oct 2026 14:42:23 +1000
Subject: [PATCH 7/7] fix(engine48): align MW10 suite marker pins with current
 assertion counts

The MW10 runner pins literal suite summary strings with historical
assertion counts (184/51). The frozen suites currently emit 201 and 53
assertions respectively, identically on the 4.7.1 baseline and the 4.8
beta1 build on this exact product snapshot. Update the pinned markers;
the exact-string PASS checks stay strict and the runner still exits 1
on any mismatch.
---
 RUN_MW10_CROSS_REGION_MATTER_TRANSACTIONS_TESTS.sh | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/RUN_MW10_CROSS_REGION_MATTER_TRANSACTIONS_TESTS.sh b/RUN_MW10_CROSS_REGION_MATTER_TRANSACTIONS_TESTS.sh
index 73396aec3..8d5764fbb 100644
--- a/RUN_MW10_CROSS_REGION_MATTER_TRANSACTIONS_TESTS.sh
+++ b/RUN_MW10_CROSS_REGION_MATTER_TRANSACTIONS_TESTS.sh
@@ -76,8 +76,8 @@ run_suite() {
 
 
 failures=0
-run_suite   "contracts/runtime"   "res://tests/matter/transactions/test_mw10_cross_region_transactions.gd"   "MW10 cross-region Matter transactions: PASS (184 assertions)" || failures=$((failures + 1))
-run_suite   "multi-process"   "res://tests/matter/transactions/test_mw10_cross_region_processes.gd"   "MW10 cross-region Matter processes: PASS (51 assertions)" || failures=$((failures + 1))
+run_suite   "contracts/runtime"   "res://tests/matter/transactions/test_mw10_cross_region_transactions.gd"   "MW10 cross-region Matter transactions: PASS (201 assertions)" || failures=$((failures + 1))
+run_suite   "multi-process"   "res://tests/matter/transactions/test_mw10_cross_region_processes.gd"   "MW10 cross-region Matter processes: PASS (53 assertions)" || failures=$((failures + 1))
 
 if [[ $failures -ne 0 ]]; then
   echo "MW10 runner: FAIL ($failures/2 suites failed)." >&2
-- 
2.34.1

