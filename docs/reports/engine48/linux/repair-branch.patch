From c1d3070fec0cd2cb87d002bb8bd3205bd0d7a4ca Mon Sep 17 00:00:00 2001
From: CONTROL <control@nanolab.local>
Date: Wed, 21 Oct 2026 13:12:01 +1000
Subject: [PATCH 4/7] fix(engine48): allow Xvfb location override in Linux SM1
 graphical gates

SM1 graphical gates hardcode /usr/bin/Xvfb, which does not exist on
hosts where Xvfb is installed rootless (no system package manager
access). Resolve the binary via XVFB_BIN with the same /usr/bin/Xvfb
default; the gate still fails closed when no executable Xvfb is
resolved.
---
 RUN_V0_SM1_AUTHORITY_RECOVERY.sh      | 2 +-
 RUN_V0_SM1_GATEWAY_FAILURE_RESTART.sh | 2 +-
 RUN_V0_SM1_GRAPHICAL.sh               | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/RUN_V0_SM1_AUTHORITY_RECOVERY.sh b/RUN_V0_SM1_AUTHORITY_RECOVERY.sh
index 58f468a91..e8fcbc868 100755
--- a/RUN_V0_SM1_AUTHORITY_RECOVERY.sh
+++ b/RUN_V0_SM1_AUTHORITY_RECOVERY.sh
@@ -37,7 +37,7 @@ if ! [[ "$ITERATIONS" =~ ^[0-9]+$ ]] || (( ITERATIONS < 1 )); then
   echo "SM1_7_10_ITERATIONS_INVALID: $ITERATIONS" >&2
   exit 6
 fi
-if [[ "$(uname -s)" == "Linux" && ! -x /usr/bin/Xvfb ]]; then
+if [[ "$(uname -s)" == "Linux" && ! -x "${XVFB_BIN:-/usr/bin/Xvfb}" ]]; then
   echo "SM1_7_10_XVFB_REQUIRED" >&2
   exit 7
 fi
diff --git a/RUN_V0_SM1_GATEWAY_FAILURE_RESTART.sh b/RUN_V0_SM1_GATEWAY_FAILURE_RESTART.sh
index a9236030a..7812a6bc6 100755
--- a/RUN_V0_SM1_GATEWAY_FAILURE_RESTART.sh
+++ b/RUN_V0_SM1_GATEWAY_FAILURE_RESTART.sh
@@ -37,7 +37,7 @@ if ! [[ "$ITERATIONS" =~ ^[0-9]+$ ]] || (( ITERATIONS < 1 )); then
   echo "SM1_7_9_ITERATIONS_INVALID: $ITERATIONS" >&2
   exit 6
 fi
-if [[ "$(uname -s)" == "Linux" && ! -x /usr/bin/Xvfb ]]; then
+if [[ "$(uname -s)" == "Linux" && ! -x "${XVFB_BIN:-/usr/bin/Xvfb}" ]]; then
   echo "SM1_7_9_XVFB_REQUIRED" >&2
   exit 7
 fi
diff --git a/RUN_V0_SM1_GRAPHICAL.sh b/RUN_V0_SM1_GRAPHICAL.sh
index a3341414f..cb0b08f3d 100644
--- a/RUN_V0_SM1_GRAPHICAL.sh
+++ b/RUN_V0_SM1_GRAPHICAL.sh
@@ -33,7 +33,7 @@ if [[ -n "$(git -C "$ROOT" status --porcelain --untracked-files=all)" ]]; then
   git -C "$ROOT" status --short >&2
   exit 5
 fi
-if [[ "$(uname -s)" == "Linux" && ! -x /usr/bin/Xvfb ]]; then
+if [[ "$(uname -s)" == "Linux" && ! -x "${XVFB_BIN:-/usr/bin/Xvfb}" ]]; then
   echo "SM1_6_XVFB_REQUIRED" >&2
   exit 6
 fi
-- 
2.34.1


From 5f71900ff2668f32b42588581b80eaa89e1c876e Mon Sep 17 00:00:00 2001
From: CONTROL <control@nanolab.local>
Date: Wed, 21 Oct 2026 13:14:43 +1000
Subject: [PATCH 5/7] fix(engine48): resolve Xvfb via XVFB_BIN in Linux
 graphical process gates

Thirteen graphical process gates construct the Xvfb display through a
hardcoded /usr/bin/Xvfb path, which does not exist on hosts where Xvfb
is installed rootless. Resolve the executable through XVFB_BIN with the
same /usr/bin/Xvfb default; gates still fail closed when no executable
Xvfb is resolved.
---
 tests/runtime/test_m2_dedicated_graphical_processes.gd        | 2 +-
 tests/runtime/test_m3_graphical_multiplayer_processes.gd      | 4 ++--
 tests/runtime/test_m4_graphical_shared_gameplay_processes.gd  | 4 ++--
 tests/runtime/test_m5_graphical_multiplayer_acceptance.gd     | 4 ++--
 tests/runtime/test_m7_playable_networked_processes.gd         | 4 ++--
 tests/runtime/test_v0_sm1_authority_recovery.gd               | 4 ++--
 tests/runtime/test_v0_sm1_concurrent_crossings.gd             | 4 ++--
 tests/runtime/test_v0_sm1_gateway_failure_restart.gd          | 4 ++--
 tests/runtime/test_v0_sm1_graphical_handoff_processes.gd      | 4 ++--
 tests/runtime/test_v0_sm1_reconnect_after_handoff.gd          | 4 ++--
 .../test_v0_sm1_repeated_crossings_impaired_network.gd        | 4 ++--
 tests/runtime/test_v0_test_client_items_processes.gd          | 4 ++--
 tests/runtime/test_v0_test_client_seam_processes.gd           | 4 ++--
 13 files changed, 25 insertions(+), 25 deletions(-)

diff --git a/tests/runtime/test_m2_dedicated_graphical_processes.gd b/tests/runtime/test_m2_dedicated_graphical_processes.gd
index 88f3cb713..f60d6ae45 100644
--- a/tests/runtime/test_m2_dedicated_graphical_processes.gd
+++ b/tests/runtime/test_m2_dedicated_graphical_processes.gd
@@ -274,7 +274,7 @@ func _spawn_process(executable: String, args: Array[String], user_root: String,
 
 
 func _start_virtual_display(root: String) -> String:
-	var executable := "/usr/bin/Xvfb"
+	var executable := (OS.get_environment("XVFB_BIN") if OS.get_environment("XVFB_BIN") != "" else "/usr/bin/Xvfb")
 	if not FileAccess.file_exists(executable):
 		failures.append("Xvfb is required for the real graphical M2 process test")
 		return ""
diff --git a/tests/runtime/test_m3_graphical_multiplayer_processes.gd b/tests/runtime/test_m3_graphical_multiplayer_processes.gd
