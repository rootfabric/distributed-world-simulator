+func _on_construction_updated(_bundle: Dictionary) -> void:
+	_construction_pending = false
+	_refresh_construction_status()
+
+
+func _on_build_next_stage_pressed() -> void:
+	if _outpost_adapter == null or _construction_pending:
+		return
+	var before: Dictionary = _outpost_adapter.get_status()
+	if not bool(before.get("ready", false)) or bool(before.get("complete", false)):
+		_refresh_construction_status()
+		return
+	_construction_pending = true
+	_refresh_construction_status()
+	var result: Dictionary = _outpost_adapter.build_next_stage_blocking()
+	_last_command_result = result.duplicate(true)
+	if not bool(result.get("success", false)):
+		_construction_pending = false
+		_last_error_code = String(result.get("error_code", "V0_OUTPOST_BUILD_REJECTED"))
+		if construction_status_label != null:
+			construction_status_label.text = "Ошибка стройки: %s" % _last_error_code
+		_refresh_construction_status(false)
+		return
+	var after: Dictionary = _outpost_adapter.get_status()
+	if int(after.get("completed_stage_count", 0)) > int(before.get("completed_stage_count", 0)):
+		_construction_pending = false
+		_refresh_construction_status()
+	elif construction_status_label != null:
+		construction_status_label.text = "Команда принята сервером · ожидаем репликацию…"
+
+
+func _refresh_construction_status(overwrite_error: bool = true) -> void:
+	if build_next_stage_button == null or construction_status_label == null:
+		return
+	if _outpost_adapter == null:
+		build_next_stage_button.disabled = true
+		construction_status_label.text = "Construction runtime недоступен"
+		return
+	var status: Dictionary = _outpost_adapter.get_status()
+	if not bool(status.get("ready", false)):
+		build_next_stage_button.disabled = true
+		construction_status_label.text = "Ожидание Construction session…"
+		return
+	if bool(status.get("complete", false)):
+		build_next_stage_button.disabled = true
+		build_next_stage_button.text = "База построена"
+		construction_status_label.text = "3/3 · фундамент + стены + крыша"
+		return
+	var stage_index := int(status.get("next_stage_index", 0))
+	var stage_label := String(status.get("next_stage_label", "этап"))
+	build_next_stage_button.disabled = _construction_pending
+	build_next_stage_button.text = "Построить: %s" % stage_label
+	if _construction_pending:
+		construction_status_label.text = "Отправка этапа %d/3…" % (stage_index + 1)
+	elif overwrite_error:
+		construction_status_label.text = "%d/3 готово · следующий: %s" % [
+			int(status.get("completed_stage_count", 0)),
+			stage_label,
+		]
 
 
