+func _update_construction_observer_frame() -> void:
+	if (
+		construction_presentation == null
+		or earth_explorer == null
+		or not construction_presentation.has_method("set_observer_tangent_frame")
+	):
+		return
+	var frame_position: Vector3 = earth_explorer.get_frame_position()
+	if frame_position.length_squared() < 1.0:
+		return
+	var up := frame_position.normalized()
+	var east := Vector3.UP.cross(up)
+	if east.length_squared() < 0.000001:
+		east = Vector3.RIGHT.cross(up)
+	east = east.normalized()
+	var north := up.cross(east).normalized()
+	var tangent_basis := Basis(east, up, -north).orthonormalized()
+	construction_presentation.set_observer_tangent_frame(
+		tangent_basis,
+		_m3_local_planar_position
+	)
