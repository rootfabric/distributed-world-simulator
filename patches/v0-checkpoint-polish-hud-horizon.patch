+func _apply_surface_locked_mouse_look(yaw_delta: float, pitch_delta: float) -> void:
+	# A networked surface player must not accumulate roll from repeated yaw/pitch
+	# rotations. Keep yaw around the local planetary normal, derive pitch from the
+	# forward vector, then rebuild a roll-free camera basis every mouse event.
+	if frame_position.length_squared() < 1.0:
+		orientation = Basis(orientation.y.normalized(), yaw_delta) * orientation
+		orientation = Basis(orientation.x.normalized(), pitch_delta) * orientation
+		orientation = orientation.orthonormalized()
+		return
+
+	var surface_up: Vector3 = frame_position.normalized()
+	var current_forward: Vector3 = (-orientation.z).normalized()
+	var current_pitch: float = asin(clampf(current_forward.dot(surface_up), -0.9999, 0.9999))
+	var horizontal_forward: Vector3 = current_forward - surface_up * current_forward.dot(surface_up)
+	if horizontal_forward.length_squared() < 0.000001:
+		horizontal_forward = -_surface_orientation(surface_up).z
+	horizontal_forward = horizontal_forward.normalized()
+	horizontal_forward = (Basis(surface_up, yaw_delta) * horizontal_forward).normalized()
+
+	var target_pitch: float = clampf(
+		current_pitch + pitch_delta,
+		deg_to_rad(-89.0),
+		deg_to_rad(89.0)
+	)
+	var right: Vector3 = horizontal_forward.cross(surface_up).normalized()
+	var forward: Vector3 = (
+		horizontal_forward * cos(target_pitch)
+		+ surface_up * sin(target_pitch)
+	).normalized()
+	var camera_up: Vector3 = right.cross(forward).normalized()
+	orientation = Basis(right, camera_up, -forward).orthonormalized()
+
+
