diff --git a/scripts/network/transports/v2/enet_multi_peer_transport_port.gd b/scripts/network/transports/v2/enet_multi_peer_transport_port.gd
--- a/scripts/network/transports/v2/enet_multi_peer_transport_port.gd
+++ b/scripts/network/transports/v2/enet_multi_peer_transport_port.gd
@@ -371,7 +371,12 @@ func _channel_index(channel: String) -> int:
 
 
 func _transfer_mode(delivery_mode: String) -> int:
-	return MultiplayerPeer.TRANSFER_MODE_UNRELIABLE if delivery_mode == "UNRELIABLE_SEQUENCED" else MultiplayerPeer.TRANSFER_MODE_RELIABLE
+	# The application still performs latest-wins sequencing, but ENet should not
+	# deliver older realtime packets after newer packets on the same physical
+	# channel. Godot's UNRELIABLE_ORDERED mode is the intended transport mapping
+	# for continuously changing movement/snapshot state.
+	return (
+		MultiplayerPeer.TRANSFER_MODE_UNRELIABLE_ORDERED
+		if delivery_mode == "UNRELIABLE_SEQUENCED"
+		else MultiplayerPeer.TRANSFER_MODE_RELIABLE
+	)
 
 
