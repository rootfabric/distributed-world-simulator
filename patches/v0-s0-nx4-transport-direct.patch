-const UNRELIABLE_TRANSPORT_MAPPING: String = "RAW_ENET_UNRELIABLE_APPLICATION_SEQUENCED_V1"
+const UNRELIABLE_TRANSPORT_MAPPING: String = "ENET_UNRELIABLE_ORDERED_APPLICATION_SEQUENCED_V1"
