; Engine configuration file.
; Project designed for a Godot 4.7.1 build compiled with precision=double.

config_version=5

[application]

config/name="Real Scale Procedural Moon"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.005, 0.005, 0.012, 1)

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.001, 0.001, 0.004, 1)

[physics]

3d/default_gravity=0.0
common/physics_interpolation=true

[debug]

gdscript/warnings/treat_warnings_as_errors=false
