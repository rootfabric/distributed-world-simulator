 var storage=F.MemoryStore.new();_ok(Persistence.save(storage,cluster),"save");var restored=Cluster.new();_ok(restored.setup(Registry.new()),"restore setup");_ok(restored.register_server(F.SERVER_A,F.CELL_A,a),"restore a");_ok(restored.register_server(F.SERVER_B,F.CELL_B,b),"restore b");_ok(restored.register_server(F.SERVER_C,F.CELL_C,c),"restore c");_ok(Persistence.load(storage,restored),"load");_assert(restored.get_registry().get_record(F.CONSTRUCT).checksum==registry.get_record(F.CONSTRUCT).checksum,"registry persistence");_assert(restored.get_replica(F.CONSTRUCT,F.SERVER_C).get_state().checksum==cluster.get_replica(F.CONSTRUCT,F.SERVER_C).get_state().checksum,"replica persistence")
 var persisted=cluster.export_state();var tampered=persisted.duplicate(true);tampered.tick=int(tampered.tick)+1;_err(restored.load_state(tampered),"CONSTRUCTION_DISTRIBUTED_AUTHORITY_STATE_CHECKSUM_MISMATCH","cluster state tamper")
 var replay_after_restore=restored.submit(F.SERVER_A,F.routed(5,F.SERVER_C,3,F.SERVER_A));_ok(replay_after_restore,"restored replay");_assert(replay_after_restore.gateway_result.replay and c.commit_count==2,"restored duplicate commit")
func _ok(r,m):_assert(bool(r.get("success",false)),"%s: %s"%[m,r])
func _err(r,c,m):_assert(not bool(r.get("success",false)) and String(r.get("error_code",""))==c,"%s: %s"%[m,r])
func _assert(v,m):assertions+=1;if not v:failures.append(m)
