 var old_replay=cluster.submit(F.SERVER_C,cmd0);_ok(old_replay,"cross epoch replay");_assert(bool(old_replay.get("cross_epoch_replay",false)) and old_replay.gateway_result.replay,"cross epoch replay marker");_assert(a.commit_count==1 and b.commit_count==0,"cross epoch replay duplicate")
 _err(cluster.submit(F.SERVER_A,F.routed(3,F.SERVER_A,1,F.SERVER_A)),"CONSTRUCTION_AUTHORITY_EPOCH_MISMATCH","stale epoch")
