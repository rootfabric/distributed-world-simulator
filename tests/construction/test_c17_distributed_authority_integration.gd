 var current=registry.get_record(F.CONSTRUCT);_assert(cluster.get_replica(F.CONSTRUCT,F.SERVER_C).get_state().owner_server_id==F.SERVER_B,"replica owner update")
 var child_state=F.state(F.CHILD,"split-child");var child_record=Record.create(F.CHILD,F.SERVER_C,F.CELL_C,1,String(child_state.checksum),[F.SERVER_A],40,F.SERVER_C,{"parent_construct_id":F.CONSTRUCT})
 _ok(cluster.register_split_child(F.CONSTRUCT,child_record,child_state),"cross zone split child");_assert(registry.get_record(F.CHILD).owner_server_id==F.SERVER_C,"child owner")
 var child_write=cluster.submit(F.SERVER_B,F.routed(4,F.SERVER_C,1,F.SERVER_B,F.CHILD));_ok(child_write,"child routed write");_assert(c.commit_count==1,"child target commit");_assert(registry.get_record(F.CONSTRUCT).owner_server_id==F.SERVER_B,"parent owner preserved")
