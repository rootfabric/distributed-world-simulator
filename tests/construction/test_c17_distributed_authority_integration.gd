 if failures.is_empty():print("C17 distributed authority integration: PASS (%d assertions)"%assertions);quit(0);return
 for f in failures:push_error(f)
 print("C17 distributed authority integration: FAIL (%d failures, %d assertions)"%[failures.size(),assertions]);quit(1)
