extends SceneTree

const UtilsScript = preload("res://scripts/network/contracts/network_contract_utils.gd")
const FixtureScript = preload("res://tests/construction/fixtures/c9_damage_split_repair_fixture.gd")
const AdapterScript = preload("res://scripts/construction/item_graph/in_memory_construction_item_graph_adapter.gd")
const PlannerScript = preload("res://scripts/construction/damage/construction_damage_planner.gd")
const ProcessScript = preload("res://scripts/construction/damage/construction_damage_process.gd")
const GhostScript = preload("res://scripts/construction/damage/construction_repair_ghost_state.gd")
const PolicyScript = preload("res://scripts/construction/damage/construction_salvage_policy.gd")
const RequestScript = preload("res://scripts/construction/damage/construction_damage_request.gd")
const ProjectionScript = preload("res://scripts/construction/item_graph/construction_item_projection.gd")

var assertions := 0
var failures: Array[String] = []

func _init() -> void:
	_test_atomic_damage_split_salvage_and_repair()
	_test_retry_replay_and_conflict()
	_test_policy_variants_and_isolation()
	_test_state_persistence_after_split()
	_finish()

func _runtime(instance_key: String = "a") -> Dictionary:
	var snapshot := FixtureScript.snapshot(instance_key)
	var items := FixtureScript.items(instance_key)
	var adapter = AdapterScript.new()
	_assert_ok(adapter.setup(items, [snapshot]), "Adapter setup failed")
	var process = ProcessScript.new()
	_assert_ok(process.setup(adapter), "Damage process setup failed")
	return {"snapshot": snapshot, "items": items, "adapter": adapter, "process": process}

func _test_atomic_damage_split_salvage_and_repair() -> void:
	var rt := _runtime("main")
	var request := FixtureScript.request("main", rt.snapshot)
	var result: Dictionary = rt.process.apply_damage("plan/c9/main/damage", "operation/c9/main/damage", request)
	_assert_ok(result, "Damage process failed")
	_assert(int(rt.adapter.get_generation()) == 1, "Damage did not advance generation once")
	_assert(result.components.size() == 3, "Damage component count mismatch")
	_assert(result.split_construct_ids == ["construct/bridge/main/split-arm"], "Damage split result mismatch")
	_assert(result.salvage_item_ids == ["item/bridge/main/sensor"], "Damage salvage result mismatch")
	var source: Dictionary = rt.adapter.get_construct_snapshot("construct/bridge/main")
	var child: Dictionary = rt.adapter.get_construct_snapshot("construct/bridge/main/split-arm")
	_assert(not source.is_empty(), "Source construct disappeared")
	_assert(not child.is_empty(), "Split construct not created")
	_assert(int(source.state_revision) == 1, "Source revision mismatch after damage")
	_assert(String(source.build_state) == "DAMAGED", "Source not marked damaged")
	_assert(source.parts.size() == 3, "Source part count after split mismatch")
	_assert(child.parts.size() == 2, "Child part count mismatch")
	_assert(int(child.state_revision) == 0, "Child initial revision mismatch")
	_assert(String(child.root_item_instance_id) == "item/bridge/main/split-root", "Child root mismatch")
	_assert(source.bonds.size() == 2, "Source live bond count mismatch")
	_assert(child.bonds.size() == 1, "Child live bond count mismatch")
	var joint: Dictionary = rt.adapter.get_item_projection("item/bridge/main/joint")
	_assert(String(joint.components.condition) == "DEGRADED", "Damaged joint item condition not updated")
	_assert(String(joint.relation.assembly_id) == "construct/bridge/main", "Retained joint moved incorrectly")
	var arm: Dictionary = rt.adapter.get_item_projection("item/bridge/main/arm")
	_assert(String(arm.relation.assembly_id) == "construct/bridge/main/split-arm", "Arm not rebound to child")
	_assert(String(arm.relation.parent_item_id) == "item/bridge/main/split-root", "Arm parent root mismatch")
	var tool: Dictionary = rt.adapter.get_item_projection("item/bridge/main/tool")
	_assert(String(tool.relation.assembly_id) == "construct/bridge/main/split-arm", "Tool not rebound to child")
	var sensor: Dictionary = rt.adapter.get_item_projection("item/bridge/main/sensor")
	_assert(String(sensor.relation.kind) == ProjectionScript.WORLD, "Sensor not salvaged to world")
	_assert(String(sensor.components.condition) == "DEGRADED", "Salvaged sensor condition not preserved")
	var split_root: Dictionary = rt.adapter.get_item_projection("item/bridge/main/split-root")
	_assert(not split_root.is_empty(), "Split root item not created")
	_assert(String(split_root.components.construction_root.construct_id) == "construct/bridge/main/split-arm", "Split root component mismatch")
	var ghost_items: Array = []
	for item_id in result.repair_plan.required_part_item_ids: ghost_items.append(rt.adapter.get_item_projection(String(item_id)))
	var ghost := GhostScript.compile(result.repair_plan, ghost_items)
	_assert_ok(ghost, "Repair ghost compile failed")
	_assert(bool(ghost.ghost.ready), "Repair ghost not ready with all items")
	var repaired: Dictionary = rt.process.apply_repair("plan/c9/main/repair", "operation/c9/main/repair", result.repair_plan)
	_assert_ok(repaired, "Repair process failed")
	_assert(int(rt.adapter.get_generation()) == 2, "Repair did not advance generation once")
	var restored: Dictionary = rt.adapter.get_construct_snapshot("construct/bridge/main")
	_assert(restored.parts.size() == 6, "Repair did not restore all parts")
	_assert(restored.bonds.size() == 5, "Repair did not restore all bonds")
	_assert(String(restored.build_state) == "OPERATIONAL", "Repair did not restore operational state")
	_assert(int(restored.state_revision) == 2, "Repair source revision mismatch")
	_assert(rt.adapter.get_construct_snapshot("construct/bridge/main/split-arm").is_empty(), "Repair did not delete child construct")
	_assert(rt.adapter.get_item_projection("item/bridge/main/split-root").is_empty(), "Repair did not delete split root item")
	for part in restored.parts:
		var projection: Dictionary = rt.adapter.get_item_projection(String(part.item_instance_id))
		_assert(String(projection.relation.assembly_id) == "construct/bridge/main", "Repaired part not attached to source")
		_assert(String(projection.relation.parent_item_id) == "item/bridge/main/root", "Repaired part root mismatch")
		_assert(String(projection.components.condition) == "INTACT", "Repaired item condition not intact")
	_assert(UtilsScript.canonical_json(restored.parts) == UtilsScript.canonical_json(rt.snapshot.parts), "Repair changed original part records")
	_assert(UtilsScript.canonical_json(restored.bonds) == UtilsScript.canonical_json(rt.snapshot.bonds), "Repair changed original bond records")

func _test_retry_replay_and_conflict() -> void:
	var rt := _runtime("retry")
	var request := FixtureScript.request("retry", rt.snapshot)
	var retryable: Dictionary = rt.process.apply_damage("plan/c9/retry/damage", "operation/c9/retry/damage", request, "BEFORE_COMMIT")
	_assert(not bool(retryable.success), "Injected failure unexpectedly succeeded")
	_assert(String(retryable.status) == "RETRYABLE", "Injected failure not retryable")
	_assert(int(rt.adapter.get_generation()) == 0, "Injected failure changed generation")
	_assert(rt.adapter.get_construct_snapshot("construct/bridge/retry/split-arm").is_empty(), "Injected failure created child construct")
	_assert(String(rt.adapter.get_item_projection("item/bridge/retry/arm").relation.assembly_id) == "construct/bridge/retry", "Injected failure moved item")
	var success: Dictionary = rt.process.apply_damage("plan/c9/retry/damage", "operation/c9/retry/damage", request)
	_assert_ok(success, "Retry after transient failure failed")
	_assert(int(rt.adapter.get_generation()) == 1, "Retry generation mismatch")
	var replay: Dictionary = rt.process.apply_damage("plan/c9/retry/damage", "operation/c9/retry/damage", request)
	_assert_ok(replay, "Process exact damage replay failed")
	_assert(bool(replay.get("replay", false)), "Process damage replay was not marked as replay")
	_assert(String(replay.repair_plan.checksum) == String(success.repair_plan.checksum), "Process replay changed repair plan")
	_assert(UtilsScript.canonical_json(replay.components) == UtilsScript.canonical_json(success.components), "Process replay changed damage components")
	_assert(int(rt.adapter.get_generation()) == 1, "Process damage replay advanced generation")
	var repaired: Dictionary = rt.process.apply_repair("plan/c9/retry/repair", "operation/c9/retry/repair", success.repair_plan)
	_assert_ok(repaired, "Repair after replay failed")
	_assert(int(rt.adapter.get_generation()) == 2, "Repair after replay generation mismatch")
	var repair_replay: Dictionary = rt.process.apply_repair("plan/c9/retry/repair", "operation/c9/retry/repair", success.repair_plan)
	_assert_ok(repair_replay, "Process exact repair replay failed")
	_assert(bool(repair_replay.get("replay", false)), "Process repair replay was not marked as replay")
	_assert(int(rt.adapter.get_generation()) == 2, "Process repair replay advanced generation")
	var before := FixtureScript.snapshot("conflict")
	var items := FixtureScript.items("conflict")
	var request2 := FixtureScript.request("conflict", before)
	var planned := PlannerScript.build_damage_plan("plan/c9/conflict/a", "operation/c9/conflict", request2, before, items)
	_assert_ok(planned, "Conflict fixture planning failed")
	var adapter = AdapterScript.new(); _assert_ok(adapter.setup(items, [before]), "Conflict adapter setup failed")
	var first := adapter.apply_damage_plan(planned.plan); _assert_ok(first, "Direct damage apply failed")
	var direct_replay := adapter.apply_damage_plan(planned.plan); _assert_ok(direct_replay, "Direct exact replay failed")
	_assert(int(adapter.get_generation()) == 1, "Direct replay advanced generation")
	var conflict_plan: Dictionary = planned.plan.duplicate(true)
	conflict_plan.plan_id = "plan/c9/conflict/b"
	conflict_plan.checksum = preload("res://scripts/construction/damage/construction_damage_transaction_plan.gd").compute_checksum(conflict_plan)
	var conflict := adapter.apply_damage_plan(conflict_plan)
	_assert_error(conflict, "CONSTRUCTION_OPERATION_ID_CONFLICT", "Adapter accepted same operation ID with different plan")
	_assert(int(adapter.get_generation()) == 1, "Operation conflict changed generation")

func _test_policy_variants_and_isolation() -> void:
	var rt := _runtime("salvage")
	var source: Dictionary = rt.snapshot
	var policy := PolicyScript.create(3, ProjectionScript.container_relation("container/salvage", -1), false)
	var request := RequestScript.create(
		"damage/bridge/salvage/impact-1", String(source.construct_id), String(source.checksum), "part/bridge/salvage/anchor",
		["bond/bridge/salvage/core-sensor", "bond/bridge/salvage/joint-arm"], [], {}, [], policy
	)
	var planned := PlannerScript.build_damage_plan("plan/c9/salvage", "operation/c9/salvage", request, source, rt.items)
	_assert_ok(planned, "All-salvage planning failed")
	_assert(planned.split_construct_ids.is_empty(), "High threshold still created split construct")
	_assert(planned.salvage_item_ids.size() == 3, "High threshold salvage count mismatch")
	var child_count := 0
	for component in planned.components:
		if String(component.outcome) == "SPLIT_CONSTRUCT": child_count += 1
	_assert(child_count == 0, "All-salvage plan contains child component")
	var rt_a := _runtime("iso-a")
	var rt_b := _runtime("iso-b")
	var result_a: Dictionary = rt_a.process.apply_damage("plan/c9/iso-a", "operation/c9/iso-a", FixtureScript.request("iso-a", rt_a.snapshot))
	_assert_ok(result_a, "Isolation damage failed")
	_assert(int(rt_b.adapter.get_generation()) == 0, "Independent adapter generation changed")
	_assert(rt_b.adapter.get_construct_snapshot("construct/bridge/iso-b").parts.size() == 6, "Independent construct changed")
	_assert(String(rt_b.adapter.get_item_projection("item/bridge/iso-b/arm").relation.assembly_id) == "construct/bridge/iso-b", "Independent item moved")

func _test_state_persistence_after_split() -> void:
	var rt := _runtime("persist")
	var result: Dictionary = rt.process.apply_damage("plan/c9/persist", "operation/c9/persist", FixtureScript.request("persist", rt.snapshot))
	_assert_ok(result, "Persistence split failed")
	var state: Dictionary = rt.adapter.export_state()
	_assert(String(state.checksum).length() == 64, "Adapter state checksum invalid")
	var restored = AdapterScript.new(); _assert_ok(restored.setup(), "Restored adapter setup failed")
	_assert_ok(restored.load_state(state), "Adapter state load failed")
	_assert(UtilsScript.canonical_json(restored.export_state()) == UtilsScript.canonical_json(state), "Adapter state roundtrip changed")
	_assert(restored.get_construct_snapshot("construct/bridge/persist").parts.size() == 3, "Persisted source part count mismatch")
	_assert(restored.get_construct_snapshot("construct/bridge/persist/split-arm").parts.size() == 2, "Persisted child part count mismatch")
	_assert(String(restored.get_item_projection("item/bridge/persist/sensor").relation.kind) == ProjectionScript.WORLD, "Persisted salvage relation mismatch")
	var tampered := state.duplicate(true)
	tampered.constructs[0].parts.append(tampered.constructs[0].parts[0].duplicate(true))
	tampered.constructs[0].checksum = preload("res://scripts/construction/contracts/construct_snapshot.gd").compute_checksum(tampered.constructs[0])
	tampered.checksum = restored.compute_state_checksum(tampered)
	var clean = AdapterScript.new(); clean.setup()
	_assert_error(clean.load_state(tampered), "DUPLICATE_PART_ID", "Adapter accepted tampered split state")
	_assert(clean.export_state().items.is_empty(), "Rejected state mutated clean adapter")

func _assert_ok(result: Dictionary, message: String) -> void:
	_assert(bool(result.get("success", false)), "%s: %s" % [message, result])
func _assert_error(result: Dictionary, code: String, message: String) -> void:
	_assert(not bool(result.get("success", false)) and String(result.get("error_code", "")) == code, "%s: %s" % [message, result])
func _assert(condition: bool, message: String) -> void:
	assertions += 1
	if not condition: failures.append(message)
func _finish() -> void:
	if failures.is_empty():
		print("C9 damage split repair integration: PASS (%d assertions)" % assertions)
		quit(0)
		return
	for failure in failures: push_error(failure)
	print("C9 damage split repair integration: FAIL (%d failures, %d assertions)" % [failures.size(), assertions])
	quit(1)
