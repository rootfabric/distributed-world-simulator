extends SceneTree
const Gate = preload("res://scripts/persistence/m6_pending_durable_ack_gate.gd")
var assertions := 0
var failures: Array[String] = []
func _init():
	call_deferred("run_tests")

func run_tests():
	var gate = Gate.new()
	check(ok(gate.configure(12, 2)), "configure base generation 12")
	check(gate.can_accept_mutation(), "initial mutation allowed")
	check(not ok(gate.stage("op/a", "peer/a", "session/a", "ITEM", {"data": {"qty": 4}}, 14)), "skip generation rejected")
	check(ok(gate.stage("op/a", "peer/a", "session/a", "ITEM", {"data": {"qty": 4}}, 13)), "stage first mutation")
	check(not gate.can_accept_mutation(), "mutation fenced while staged")
	check(gate.peek_ack().is_empty(), "no early ACK on stage")
	check(not ok(gate.stage("op/b", "peer/b", "session/b", "ITEM", {}, 13)), "single inflight commit")
	check(not ok(gate.mark_submitted("op/a", 14)), "cannot submit wrong generation")
	check(ok(gate.mark_submitted("op/a", 13)), "worker submission ordered")
	check(not ok(gate.mark_submitted("op/a", 13)), "double submission rejected")
	check(gate.peek_ack().is_empty(), "no early ACK while worker pending")
	check(not ok(gate.complete("op/a", 14, {"success":true,"generation":14})), "stale completion cannot unlock")
	check(gate.peek_ack().is_empty(), "ACK withheld after stale completion")
	check(ok(gate.complete("op/a", 13, {"success":true,"generation":13})), "commit 13 acknowledged by worker")
	check(gate.get_report()["generation"] == 13, "generation advanced once")
	check(gate.peek_ack().get("state", "") == "ACK_ELIGIBLE", "ACK eligible only after commit")
	var ack: Dictionary = gate.peek_ack()
	ack["result"]["data"]["qty"] = 100
	check(gate.peek_ack()["result"]["data"]["qty"] == 4, "ACK deep copy cannot mutate escrow")
	check(not ok(gate.mark_delivered("op/a", "peer/a", "session/wrong")), "old session fence on ack")
	check(not ok(gate.mark_delivered("op/b", "peer/a", "session/a")), "ACK exact operation required")
	check(ok(gate.mark_delivered("op/a", "peer/a", "session/a")), "ACK removed after deliver")
	check(gate.peek_ack().is_empty(), "delivered ack not repeated")
	check(ok(gate.stage("op/b", "peer/b", "session/b", "ITEM", {}, 14)), "new generation after delivery")
	check(ok(gate.mark_submitted("op/b", 14)), "submit generation 14")
	check(ok(gate.complete("op/b", 14, {"success":true,"generation":14})), "commit 14")
	check(not ok(gate.stage("op/b", "peer/b", "session/b", "ITEM", {}, 15)), "duplicate pending ACK escrow rejected")
	check(ok(gate.stage("op/c", "peer/c", "session/c", "BUILD", {}, 15)), "second ready slot allowed")
	check(ok(gate.mark_submitted("op/c", 15)), "submit gen 15")
	check(ok(gate.complete("op/c", 15, {"success":true,"generation":15})), "commit gen 15")
	check(not gate.can_accept_mutation(), "ready queue backpressure")
	check(not ok(gate.stage("op/d", "peer/d", "session/d", "BUILD", {}, 16)), "ready limit enforced")
	check(not ok(gate.mark_delivered("op/c", "peer/c", "session/c")), "FIFO ACK delivery enforced")
	check(ok(gate.discard_stale_session("peer/b", "session/b")), "can drop old connection ACK")
	check(gate.get_report()["ready_count"] == 1, "old session ACK removed")
	check(ok(gate.mark_delivered("op/c", "peer/c", "session/c")), "latest ACK delivered")
	check(gate.can_accept_mutation(), "mutation available again")
	check(ok(gate.observe_periodic_commit(16)), "periodic generation observed")
	check(not ok(gate.observe_periodic_commit(18)), "periodic generation cannot skip")
	check(ok(gate.stage("op/e", "peer/e", "session/e", "ITEM", {}, 17)), "stage after backpressure")
	check(ok(gate.mark_submitted("op/e", 17)), "submit before fault")
	check(not ok(gate.observe_periodic_commit(17)), "periodic cannot overtake pending")
	check(not ok(gate.complete("op/e", 17, {"success":false,"generation":17})), "failed worker cannot ACK")
	check(gate.peek_ack().is_empty(), "no ACK on failed persistence")
	check(gate.get_report()["generation"] == 16, "failed command generation not advanced")
	check(gate.get_report()["fatal"], "gate fail closed after disk error")
	check(not gate.can_accept_mutation(), "fatal blocks mutating commands")
	check(not ok(gate.stage("op/f", "peer/f", "session/f", "ITEM", {}, 17)), "fatal blocks new stage")
	var recovered = Gate.new()
	check(ok(recovered.configure(16)), "restart derives durable generation from recovery")
	check(recovered.peek_ack().is_empty(), "no fake ACK on restart")
	check(ok(recovered.stage("op/e", "peer/e", "session/new", "ITEM", {}, 17)), "replay-safe retry can be staged if recovery says not committed")
	check(not ok(recovered.complete("op/e", 17, {"success":true,"generation":17})), "cannot complete without submit")
	check(ok(recovered.mark_submitted("op/e", 17)), "submit on restarted gate")
	check(not ok(recovered.complete("op/e", 17, {"success":true,"generation":18})), "mismatched worker result fails closed")
	check(recovered.get_report()["fatal"], "fake completed generation is fatal")
	var stale = Gate.new()
	check(ok(stale.configure(41)), "prepare disconnect while pending")
	check(ok(stale.stage("op/stale", "peer/x", "session/old", "ITEM", {}, 42)), "stage stale peer")
	check(ok(stale.mark_submitted("op/stale", 42)), "submit stale peer")
	check(ok(stale.discard_stale_session("peer/x", "session/old")), "disconnect invalidates pending ACK")
	check(ok(stale.complete("op/stale", 42, {"success":true,"generation":42})), "committed during disconnect")
	check(stale.get_report()["generation"] == 42, "disconnected command remains durable")
	check(stale.peek_ack().is_empty(), "ACK not sent into disconnected session")
	check(stale.can_accept_mutation(), "fence released after disconnected committed op")
	check(not ok(Gate.new().configure(-1)), "invalid base generation rejected")
	check(not ok(Gate.new().configure(0, 129)), "unbounded escrow rejected")
	for reason in failures:
		push_error(reason)
	print("NET_SMOOTH1_R41_PENDING_DURABLE_GATE: %s assertions=%d failures=%d" % ["PASS" if failures.is_empty() else "FAIL", assertions, failures.size()])
	quit(0 if failures.is_empty() else 1)

func ok(result: Dictionary) -> bool:
	return bool(result.get("success", false))
func check(condition: bool, name: String):
	assertions += 1
	if not condition:
		failures.append(name)
