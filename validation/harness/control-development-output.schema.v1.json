    "source": {"const":"GIT_ONLY_WORKER_DATA"}, "repository":{"type":"object"}, "epoch":{"type":"object"}, "active_work_order":{"type":"object"}, "reduced_work_order":{"type":"object"}, "review":{"type":"object"}, "human_attention":{"type":"object"},
